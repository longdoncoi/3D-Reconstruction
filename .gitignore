# Directories with generated files
.moc/
.obj/
.pch/
.rcc/
.uic/
/build*/
/AITraining/runs/
/.ruff_cache/
/.vs/
/AIAssistant/Cache/
# Runtime RAG caches + agent audit log (regenerated while the server runs).
/Cache/
/AIAssistant/Docs/*
!/AIAssistant/Docs/adr/
!/AIAssistant/Docs/archive/
!/AIAssistant/Docs/RUNBOOK.md
# The measured scorecard is evidence, not scratch: ADR 0015 says a claim must
# be pinned or removed. A scorecard nobody else can read pins nothing, so it
# is tracked (ADR 0032).
!/AIAssistant/Docs/SCORECARD.md
/AIAssistant/logs/
# Legacy location the composition root used before it resolved the package root.
/AIAssistant/src/logs/
# Local LLM weights (large; intentionally not tracked, not stored via Git LFS).
/AIAssistant/Models/
/AIAssistant/agent_audit.jsonl
/AIAssistant/tasks.sqlite
# Long-term memory store (ADR 0043): a runtime artifact created by a default
# path, never a source file.
/AIAssistant/memory.sqlite
# Runtime pending-approval / UI-ACK state, rewritten on every agent run.
/AIAssistant/pending_agent_actions.json
# Eval run output — rewritten by `evals/run_*.py` and uploaded as a CI artifact
# by the agent-evals workflow; never a source file.
/AIAssistant/evals/latest_tool_call_report.json
/AIAssistant/evals/agentic_eval_report.json
/AIAssistant/evals/model_in_loop_report.json
/AIAssistant/evals/sbom.json
# Coverage artifacts (Python)
/AIAssistant/.coverage
/AIAssistant/htmlcov/
/AIAssistant/AIAssistant/
/AIAssistant/.env
/AIAssistant/.import_linter_cache/
/AIAssistant/.mypy_cache/
/AIAssistant/.ruff_cache/
# mutation_check's in-flight lock — its absence is what "safe to mutate" means.
/AIAssistant/scripts/.mutation_check.lock
/AIComputerVision/scripts/.mutation_check.lock
/AIAssistant/Models/.cache/
**/__pycache__/
/AIComputerVision/runs/
# Coverage artifacts (AIComputerVision) — produced by `coverage run`.
/AIComputerVision/.coverage
/AIComputerVision/.coverage.*
/AIComputerVision/htmlcov/
# One-generation rollback copy beside a replaced export (cvtrain.fsio). Never a
# model the app loads, and never an LFS artifact.
/AIComputerVision/Models/*.onnx.bak
# Advisory lock a training run holds over Models/ (cvtrain.fsio), and copies of
# a manifest that could not be parsed (cvtrain.manifest). Never tracked.
/AIComputerVision/Models/.cvtrain.lock
# Sidecar claim that serialises stealing a stale lock; abandoned only by a crash.
/AIComputerVision/Models/.cvtrain.lock.steal
/AIComputerVision/Models/manifest.json.corrupt-*

# Custom App Ignores
/Predict/
/Models/
/Dataset/
/Dicom/
/3DModels/
/Thumbnails/
/VideoTracking/
/Doxygen/html/
/Doxygen/latex/
/AITraining/Cache/
/AITraining/logs/
/AITraining/pending_agent_actions.json
/AITraining/Docs/
/AITraining/Models/*.onnx
/Config/chat_sessions*.json
/Config/config*.ini
/Config/Config*.ini
/Config/Config_User.ini
/Logs/
/Upload/
# Generated reconstruction mesh caches (all variants; e.g. recon_mesh_cache_v3.ply).
/3DRecontruction/**/recon_*cache*.ply

# Transient junk artifacts (Windows `nul` redirection, checkpoint dumps, local DBs)
nul
/nul
/AIAssistant/nul
chkpt_run.log
/AIAssistant/chkpt_run.log
opencode.db
/opencode.db

# Local OpenAI Codex CLI agent config (kept out of the repository).
/.codex/
