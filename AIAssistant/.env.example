# Tool decoding / local runtime
AGENT_SANDBOX_ENABLED=1
# Use the grammar fallback by default; enable only with a model/chat template
# proven to emit llama-cpp native function calls.
AGENT_NATIVE_TOOL_CALLS=0
# AGENT_SANDBOX_RUNTIME=docker
# AGENT_SANDBOX_IMAGE=your-approved-tool-image
# AGENT_WRITE_ALLOWLIST=src,AITraining,Config,Docs,tests
# Production gate (ADR 0023): refuse to run commands unless the docker runtime
# is active. An allow-list is not an OS boundary, so set this to 1 for any
# deployment where tool output is untrusted. Local desktop keeps 0.
# AGENT_SANDBOX_REQUIRE_ISOLATION=1
AGENT_CHECKPOINT_BACKEND=memory
# AGENT_CHECKPOINT_BACKEND=postgres
# AGENT_CHECKPOINT_URL=postgresql://agent:password@localhost:5432/agent
# Production gate (ADR 0023): fail startup instead of silently degrading to the
# in-memory checkpointer. Requires a durable backend above (sqlite/postgres/redis).
# AGENT_CHECKPOINT_REQUIRED=1
# Admission governor (ADR 0024). Both default to off for the single-user desktop;
# turn them on for any shared/server deployment.
# AGENT_MAX_CONCURRENT_RUNS=4
# AGENT_RATE_LIMIT_PER_MINUTE=120

# Observability
AGENT_OBSERVABILITY=0
# OTLP collector URL (full traces path). Spans are shipped only while
# AGENT_OBSERVABILITY=1 and `opentelemetry-exporter-otlp-proto-http` is
# installed; otherwise the wiring logs one warning and spans stay in-process.
# AGENT_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Optional LangSmith tracing. Put the real API key in AIAssistant/.env, which
# is intentionally ignored by Git.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=3d-reconstruction

# Scale: keep llama_cpp for the desktop-local model; point at vLLM or TGI only
# when concurrent users justify a shared inference server.
AGENT_INFERENCE_BACKEND=llama_cpp
# AGENT_INFERENCE_URL=http://localhost:8000
# AGENT_INFERENCE_MODEL=your-model

# Hybrid privacy policy. Cloud use is only permitted for public/non_sensitive
# data when explicitly set to cloud_allowed.
AGENT_HYBRID_POLICY=local_only

# At-rest key for local state (ADR 0027/0028). Task messages, tool arguments,
# model output, the event log and the RAG cache (which holds a second copy of
# your indexed documents) are sealed with AES-256-GCM before they reach
# tasks.sqlite / pending_agent_actions.json / Cache/. Sources are tried in
# order and every one of them is fail-closed: a malformed key, or a missing
# AI_STORAGE_KEY_FILE, aborts startup instead of silently generating a
# replacement (which would make the existing state unreadable).
# AI_STORAGE_KEY=base64:<32-byte url-safe key>
#   Also accepts hex:<64 hex digits> or a bare url-safe base64 value.
# AI_STORAGE_KEY_FILE=/run/secrets/ai_assistant.key
#   A mounted secret file. Missing or unreadable => the server refuses to
#   start. Back this up with the same procedure as the data volume: losing
#   the key means losing the state.
# With neither set, one key is generated on first run and reused from
# %LOCALAPPDATA%\3d-reconstruction\ai_assistant.key (Windows) or
# $XDG_CONFIG_HOME/3d-reconstruction/ai_assistant.key (POSIX) — outside
# APP_DATA_DIR, so a data-volume backup does not carry the key with it.

# Model path. Vision is on by default; set it to 0 to keep a non-vision model
# even when the registry entry declares one.
# AI_ENABLE_VISION_LLM=1

# Transport trust (ADR 0008). Every surface already refuses non-loopback peers
# and foreign browser origins; a token below is extra hardening — when set it
# is required even from loopback. Remote A2A additionally needs
# allow_remote_a2a in Config/agent_config.toml and one credential source:
# AI_A2A_TOKEN (single tenant) or AI_A2A_TENANTS (JSON bearer -> tenant map).
# AI_ADMIN_TOKEN=
# AI_AGENT_TOKEN=
# AI_A2A_TOKEN=
# AI_A2A_TENANTS={"token-a": "alpha", "token-b": "beta"}
# AI_A2A_MAX_SUBSCRIBERS=32
# AI_TASK_RETENTION_DAYS=30
#   Terminal A2A tasks older than this are pruned at startup; 0 disables.
# AI_MCP_TOKEN=
#   Opts /mcp into remote access. Unset keeps the mount loopback-only, and the
#   mount stays closed entirely when AGENT_HOST is public and this is empty.
