# Tool decoding / local runtime
AGENT_SANDBOX_ENABLED=1
# Use the grammar fallback by default; enable only with a model/chat template
# proven to emit llama-cpp native function calls.
AGENT_NATIVE_TOOL_CALLS=0
# AGENT_SANDBOX_RUNTIME=docker
# AGENT_SANDBOX_IMAGE=your-approved-tool-image
# AGENT_WRITE_ALLOWLIST=src,AITraining,Config,Docs,tests
AGENT_CHECKPOINT_BACKEND=memory
# AGENT_CHECKPOINT_BACKEND=postgres
# AGENT_CHECKPOINT_URL=postgresql://agent:password@localhost:5432/agent

# Observability
AGENT_OBSERVABILITY=0
# OTLP collector URL (full traces path). Spans are shipped only while
# AGENT_OBSERVABILITY=1 and `opentelemetry-exporter-otlp-proto-http` is
# installed; otherwise the wiring logs one warning and spans stay in-process.
# AGENT_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Optional LangSmith tracing. Put the real API key in AIAssistant/.env, which
# is intentionally ignored by Git.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=3d-reconstruction

# Scale: keep llama_cpp for the desktop-local model; point at vLLM or TGI only
# when concurrent users justify a shared inference server.
AGENT_INFERENCE_BACKEND=llama_cpp
# AGENT_INFERENCE_URL=http://localhost:8000
# AGENT_INFERENCE_MODEL=your-model

# Hybrid privacy policy. Cloud use is only permitted for public/non_sensitive
# data when explicitly set to cloud_allowed.
AGENT_HYBRID_POLICY=local_only

# Model path. Vision is on by default; set it to 0 to keep a non-vision model
# even when the registry entry declares one.
# AI_ENABLE_VISION_LLM=1

# Transport trust (ADR 0008). Every surface already refuses non-loopback peers
# and foreign browser origins; a token below is extra hardening — when set it
# is required even from loopback. Remote A2A additionally needs
# allow_remote_a2a in Config/agent_config.toml *and* AI_A2A_TOKEN.
# AI_ADMIN_TOKEN=
# AI_AGENT_TOKEN=
# AI_A2A_TOKEN=
# AI_MCP_TOKEN=
#   Opts /mcp into remote access. Unset keeps the mount loopback-only, and the
#   mount stays closed entirely when AGENT_HOST is public and this is empty.
