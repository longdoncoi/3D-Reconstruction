# Writes the generated header that carries the plugin-facing interface ABI
# hash. Invoked by the custom command in CMakeLists.txt, which depends on
# every file of the surface — so the generated value can never go stale.
#
# Inputs (from the command line):
#   APP_INTERFACE_ROOTS        — the roots of the surface
#   APP_INTERFACE_SEARCH_DIRS  — where quoted/angle-bracket includes resolve
#   APP_SDK_FINGERPRINT        — VTK/OpenCV/ONNX Runtime version fingerprint
#   OUTPUT                     — the header to write

include("${CMAKE_CURRENT_LIST_DIR}/InterfaceAbi.cmake")

if(NOT DEFINED APP_INTERFACE_ROOTS OR NOT DEFINED APP_INTERFACE_SEARCH_DIRS
   OR NOT DEFINED APP_SDK_FINGERPRINT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR
        "GenerateInterfaceAbi.cmake needs APP_INTERFACE_ROOTS, "
        "APP_INTERFACE_SEARCH_DIRS, APP_SDK_FINGERPRINT and OUTPUT")
endif()

collect_interface_surface(_surface APP_INTERFACE_ROOTS APP_INTERFACE_SEARCH_DIRS)
compute_interface_abi_hash(_hash ${_surface})

# Only rewrite the header when the VALUE changes. file(WRITE) always updates
# the timestamp, and because IPlugin.h includes this header every target of the
# project (AppCore, all plugins, the executable, their AUTOMOC runs) would then
# rebuild even though no interface changed — a touch, a git checkout or a
# formatter-only edit used to cost a full 2.5-minute rebuild.
#
# file(READ) normalises CRLF to LF on Windows and file(WRITE) restores the
# platform line endings, so a straight string comparison is byte-stable.
set(_content
"// ─── AUTO-GENERATED — do not edit ───────────────────────────────────────────
// Content hash of the plugin-facing interface surface: the transitive
// #include closure of src/include/*.h and src/utils/*.h (the I*.h interfaces,
// the allow-listed core glue and the DTOs they expose).
//
// APP_TOOLCHAIN_SDK_FINGERPRINT is the VTK/OpenCV/ONNX Runtime version
// fingerprint: those types cross the plugin boundary, so a different SDK is a
// different ABI even when Qt and the compiler are identical.
//
// Regenerated by CMake whenever one of those files changes, so the value can
// never go stale. See cmake/InterfaceAbi.cmake and cmake/PluginInterface.cmake.
#pragma once
#define APP_INTERFACE_ABI_HASH ${_hash}ULL
#define APP_TOOLCHAIN_SDK_FINGERPRINT ${APP_SDK_FINGERPRINT}ULL
")

set(_changed TRUE)
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _existing)
    if(_existing STREQUAL _content)
        set(_changed FALSE)
    endif()
endif()

if(_changed)
    file(WRITE "${OUTPUT}" "${_content}")
    message(STATUS "Interface ABI hash: ${_hash} (regenerated)")
else()
    message(STATUS "Interface ABI hash: ${_hash} (unchanged)")
endif()

